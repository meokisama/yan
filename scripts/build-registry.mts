/**
 * Generates `registry.json` and `styles/yan-theme.css` from `registry/`.
 * Run via `yarn registry:build` (which then calls `shadcn build`).
 *
 * The registry URL defaults to https://yan.moe. To test installs against a local server:
 *
 *   REGISTRY_URL=http://localhost:3000 yarn registry:build
 */
import { mkdirSync, writeFileSync } from "node:fs"
import { join } from "node:path"

import { registryItems } from "../registry/index.ts"
import { yanTheme } from "../registry/theme.ts"

const root = join(import.meta.dirname, "..")
const base = (process.env.REGISTRY_URL ?? process.env.NEXT_PUBLIC_SITE_URL ?? "https://yan.moe").replace(/\/$/, "")

// 1. registry.json
const registry = {
  $schema: "https://ui.shadcn.com/schema/registry.json",
  name: "yan",
  homepage: base,
  items: registryItems.map((item) => ({
    $schema: undefined,
    ...item,
    registryDependencies: item.registryDependencies?.map((d) => d.replace("{{BASE}}", base)),
  })),
}
writeFileSync(join(root, "registry.json"), JSON.stringify(registry, null, 2) + "\n")

// 2. styles/yan-theme.css: the same tokens, for this docs site.
const decls = (vars: Record<string, string>, indent = "  ") =>
  Object.entries(vars).map(([k, v]) => `${indent}--${k}: ${v};`).join("\n")

const toCss = (obj: Record<string, unknown>, indent = ""): string =>
  Object.entries(obj)
    .map(([key, value]) =>
      typeof value === "object" && value !== null
        ? `${indent}${key} {\n${toCss(value as Record<string, unknown>, indent + "  ")}\n${indent}}`
        : `${indent}${key}: ${value};`
    )
    .join("\n")

const css = `/* GENERATED by scripts/build-registry.mts from registry/theme.ts. Do not edit. */

:root {
${decls(yanTheme.light)}
}

.dark {
${decls(yanTheme.dark)}
}

@theme inline {
${decls(yanTheme.theme)}
}

${toCss(yanTheme.css)}
`
// styles/ holds only this gitignored file, so a fresh clone does not have it.
mkdirSync(join(root, "styles"), { recursive: true })
writeFileSync(join(root, "styles/yan-theme.css"), css)

console.log(`✿ registry.json (${registryItems.length} items, base ${base}) + styles/yan-theme.css`)
